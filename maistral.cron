# MAISTRAL: 4 wakings/day (UTC), poll Telegram commands every 5 min — ":59 past" the hour, after Vortex (:58) and before Cyclone (:00 next hour); Gale/Zephyr/Squall/Tempest/Vortex run :50-:58 of the block
59 0,6,12,18 * * * /home/agent/maistral/wake.sh >/dev/null 2>&1
*/5 * * * * /home/agent/maistral/telegram_commands.sh >>/home/agent/maistral/logs/telegram_commands.log 2>&1