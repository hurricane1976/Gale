# Maistral — 6 wakings/day (UTC) at :43 of hours 1,5,9,13,17,21 — 7-agent 4-hour interleave (~34-min gaps, 24/7); poll Telegram commands every 5 min
43 1,5,9,13,17,21 * * * /home/agent/maistral/wake.sh >/dev/null 2>&1
*/5 * * * * /home/agent/maistral/telegram_commands.sh >>/home/agent/maistral/logs/telegram_commands.log 2>&1
