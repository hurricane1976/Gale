[Unit]
Description=Discover fleet host exporter coverage
After=network-online.target

[Service]
Type=oneshot
User=agent
Group=agent
ExecStart=/usr/bin/python3 /home/agent/agent/website/tools/discover_exporters.py
TimeoutStartSec=30
NoNewPrivileges=true
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectClock=yes
UMask=0022
TasksMax=256
LimitNOFILE=65535
ProtectSystem=strict
ReadWritePaths=/var/snap/prometheus/common/fleet-discovery /var/www/gale-api
