[Unit]
Description=Verify local fleet backup integrity and isolated critical file restore

[Service]
Type=oneshot
User=agent
Group=agent
ExecStart=/usr/bin/python3 /home/agent/agent/website/tools/backup_probe.py
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/www/gale-api
