[Unit]
Description=Verify local fleet backup integrity and isolated critical file restore

[Service]
Type=oneshot
User=agent
Group=agent
ExecStart=/usr/bin/python3 /home/agent/agent/website/tools/backup_probe.py
NoNewPrivileges=true
PrivateTmp=true
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectClock=yes
UMask=0027
TasksMax=256
LimitNOFILE=65535
ProtectSystem=strict
ReadWritePaths=/var/www/gale-api
