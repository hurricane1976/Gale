# Tramontane: 6 wakings/day (UTC) at :25 of hours 3,7,11,15,19,23 — 7-agent 4-hour interleave (~34-min gaps, 24/7); poll Telegram commands every 5 min
25 3,7,11,15,19,23 * * * /home/agent/tramontane/wake.sh >/dev/null 2>&1
*/5 * * * * /home/agent/tramontane/telegram_commands.sh >>/home/agent/tramontane/logs/telegram_commands.log 2>&1
