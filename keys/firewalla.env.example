# Copy this file to firewalla.env (same directory) and fill in real values.
# firewalla.env is gitignored -- never commit real credentials.
#
# FIREWALLA_MSP_DOMAIN: your MSP portal's domain, e.g. xxxxxxxx.firewalla.net
# FIREWALLA_PAT: a Personal Access Token -- MSP UI -> Account Settings ->
#                Create New Token. This is an account-wide credential: it
#                can reach every box on the MSP account, not just one, and
#                (once the control service is live) can create/pause/resume
#                block rules -- treat it like the Telegram bot token, never
#                print it, never put it in NOTES.md/logs, never send it to
#                anything other than https://$FIREWALLA_MSP_DOMAIN.
FIREWALLA_MSP_DOMAIN=
FIREWALLA_PAT=
