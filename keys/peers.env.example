# Copy this file to peers.env (same directory) and fill in real values.
# peers.env is gitignored -- never commit real credentials.
#
# After editing:
#   chmod 600 peers.env
#   sudo systemctl restart chinook-peer
#
# SELF_NAME: what THIS box calls itself -- other peers will see messages
#            you send tagged with this name.
# SELF_BIND: the Tailscale IP:port peer_server.py listens on. This MUST be
#            this box's tailscale0 address (100.x.x.x), never 0.0.0.0 and
#            never a public IP -- peer_server.py refuses to start
#            otherwise. Find it with `tailscale ip -4`.
SELF_NAME=CHINOOK
SELF_BIND=100.66.39.59:8793

# One block below per peer you want to talk to -- repeat the three lines
# for additional peers, in any order, with or without blank lines between
# them. TOKEN must be the exact same shared secret both sides use for this
# specific pairing: generate it once (e.g. `openssl rand -hex 32`) and
# paste the identical value into both boxes' peers.env.
NAME=REPLACE_ME
ADDR=100.REPLACE.WITH.PEER.BOX.TAILSCALE.IP:PORT
TOKEN=REPLACE_ME
