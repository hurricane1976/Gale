# Bora — 6 wakings/day (UTC) at :34 of hours 0,4,8,12,16,20 — 7-agent 4-hour interleave (~34-min gaps, 24/7); poll Telegram commands every 5 min
34 0,4,8,12,16,20 * * * /home/agent/bora/wake.sh >/dev/null 2>&1
*/5 * * * * /home/agent/bora/telegram_commands.sh >>/home/agent/bora/logs/telegram_commands.log 2>&1
